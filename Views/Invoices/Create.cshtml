@model ElectricalBilling.ViewModels.InvoiceViewModel
@{
    ViewData["Title"] = "New Bill";
}

<div class="px-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h3 class="fw-bold mb-0">+ New Bill</h3>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Bills</a>
    </div>

    <div class="card shadow-sm p-4">
        <form asp-action="Create" method="post">
            @await Html.PartialAsync("_InvoiceForm", Model)
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/invoice.js" asp-append-version="true"></script>
}
