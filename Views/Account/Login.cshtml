@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="container-fluid min-vh-100 p-0">
    <div class="row g-0 min-vh-100">

        <!-- Left Side: Brand / Visual Panel -->
        <div class="col-lg-7 d-none d-lg-flex flex-column justify-content-between p-5 bg-dark text-white position-relative overflow-hidden">
            <div class="position-absolute top-0 start-0 w-100 h-100 opacity-10 bg-grid-pattern"></div>

            <div>
                <span class="badge bg-primary bg-opacity-25 text-info px-3 py-2 rounded-pill fw-semibold small">
                    <i class="bi bi-lightning-charge-fill me-1"></i> Enterprise Portal
                </span>
            </div>

            <div class="my-auto py-5 z-1">
                <h1 class="display-5 fw-bold tracking-tight mb-3 text-white">LEELADHAR BHATT</h1>
                <p class="text-info font-monospace fs-6 mb-4 lh-lg opacity-90">
                    POWER FACTOR &bull; HT/LT CABLING &bull; APFC PANEL<br />
                    EARTH TESTING &bull; TRANSFORMER OIL TESTING
                </p>
                <div style="width: 60px; height: 3px; background: #0dcaf0;" class="rounded"></div>
            </div>

            <div class="text-white-50 small">
                &copy; @DateTime.Now.Year Digital Electrical Billing System. All rights reserved.
            </div>
        </div>

        <!-- Right Side: Login Form Panel -->
        <div class="col-lg-5 d-flex align-items-center justify-content-center p-4 p-sm-5 bg-white">
            <div class="w-100" style="max-width: 400px;">

                <div class="mb-4 text-center text-lg-start">
                    <div class="d-inline-flex d-lg-none align-items-center justify-content-center bg-light rounded-3 p-3 mb-3 border">
                        <i class="bi bi-lightning-charge-fill text-primary fs-4"></i>
                    </div>
                    <h3 class="fw-bold text-dark mb-1">Welcome Back</h3>
                    <p class="text-muted small">Please enter your credentials to access the system.</p>
                </div>

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" autocomplete="off">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3 mb-4 border-0 bg-danger-subtle text-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="UsernameOrEmail" class="form-control rounded-3 border-light-subtle bg-light" placeholder="Username or Email" autofocus required />
                        <label asp-for="UsernameOrEmail" class="text-muted small">Username or Email</label>
                        <span asp-validation-for="UsernameOrEmail" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Password" type="password" class="form-control rounded-3 border-light-subtle bg-light" placeholder="Password" required />
                        <label asp-for="Password" class="text-muted small">Password</label>
                        <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input rounded-1" />
                            <label asp-for="RememberMe" class="form-check-label text-muted small user-select-none">Remember me</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-dark w-100 py-3 fw-semibold rounded-3 shadow-sm">
                        Sign In <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </form>

            </div>
        </div>

    </div>
</div>

<style>
    .bg-grid-pattern {
        background-image: radial-gradient(rgba(255, 255, 255, 0.2) 1px, transparent 1px);
        background-size: 24px 24px;
    }

    .form-control:focus {
        background-color: #fff !important;
        border-color: #0d6efd !important;
        box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.08) !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}