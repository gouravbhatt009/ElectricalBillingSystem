@model ServiceViewModel

<input type="hidden" asp-for="ServiceId" />
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="ServiceName" class="form-label"></label>
        <input asp-for="ServiceName" class="form-control" autofocus />
        <span asp-validation-for="ServiceName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DefaultRate" class="form-label"></label>
        <input asp-for="DefaultRate" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="DefaultRate" class="text-danger"></span>
        <div class="form-text">Optional. Pre-fills the rate on the invoice screen; can be overridden per bill.</div>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
    </div>

    @if (Model.ServiceId != 0)
    {
        <div class="col-12">
            <div class="form-check form-switch fs-5">
                <input asp-for="IsActive" class="form-check-input" role="switch" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    }
</div>

<div class="mt-4">
    <button type="submit" class="btn btn-primary btn-lg px-5">Save Service</button>
    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancel</a>
</div>
