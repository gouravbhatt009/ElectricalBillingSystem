@model List<ElectricalBilling.ViewModels.PaidInvoiceReportItem>
@{
    ViewData["Title"] = "Paid Invoices Report";
    var filter = (ElectricalBilling.ViewModels.ReportFilter)ViewBag.Filter;
    ViewData["ReportAction"] = "Paid";
}

<div class="px-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h3 class="fw-bold mb-0">Paid Invoices Report</h3>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Back to Reports</a>
            <a asp-action="Export" asp-route-type="paid"
               asp-route-DateFrom="@filter.DateFrom?.ToString("yyyy-MM-dd")" asp-route-DateTo="@filter.DateTo?.ToString("yyyy-MM-dd")"
               asp-route-CustomerId="@filter.CustomerId"
               class="btn btn-success">Export CSV</a>
        </div>
    </div>

    <div class="card shadow-sm p-3 mb-3">
        <partial name="_ReportFilter" model="filter" />
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Bill No</th><th>Date</th><th>Customer</th><th class="text-end">Invoice Amount</th><th class="text-end">Paid Amount</th><th>Last Payment</th></tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No fully paid bills for this period.</td></tr>
                    }
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td><a asp-controller="Invoices" asp-action="Details" asp-route-id="@row.InvoiceId">@row.InvoiceNumber</a></td>
                            <td>@row.InvoiceDate.ToString("dd/MM/yyyy")</td>
                            <td>@row.CustomerName</td>
                            <td class="text-end">₹@row.InvoiceAmount.ToString("N2")</td>
                            <td class="text-end text-success">₹@row.PaidAmount.ToString("N2")</td>
                            <td>@(row.LastPaymentDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
