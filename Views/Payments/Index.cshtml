@model ElectricalBilling.ViewModels.PagedResult<ElectricalBilling.ViewModels.RecentPaymentViewModel>
@{
    ViewData["Title"] = "Payments";
    var search = ViewData["Search"] as string;
}

<div class="px-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h3 class="fw-bold mb-0">Payments</h3>
        <a asp-controller="Invoices" asp-action="Index" class="btn btn-outline-primary">Find a Bill to Record a Payment</a>
    </div>

    <div class="card shadow-sm p-3 mb-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-6 col-8">
                <label class="form-label small">Search Bill No. / Customer / Mobile</label>
                <input type="text" name="search" value="@search" class="form-control" />
            </div>
            <div class="col-md-2 col-4">
                <button type="submit" class="btn btn-primary w-100">Search</button>
            </div>
        </form>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Bill No</th>
                        <th>Customer</th>
                        <th>Mode</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No payments found.</td></tr>
                    }
                    @foreach (var payment in Model.Items)
                    {
                        <tr>
                            <td>@payment.PaymentDate.ToString("dd/MM/yyyy")</td>
                            <td>@payment.InvoiceNumber</td>
                            <td>@payment.CustomerName</td>
                            <td>@payment.PaymentMode</td>
                            <td class="text-end">₹@payment.Amount.ToString("N2")</td>
                            <td class="text-end">
                                <a asp-controller="Invoices" asp-action="Details" asp-route-id="@payment.InvoiceId" class="btn btn-sm btn-outline-primary">View Bill</a>
                                <a asp-action="Edit" asp-route-id="@payment.PaymentId" class="btn btn-sm btn-outline-secondary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="Payment list pages">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                </li>
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-page="@(Model.PageNumber + 1)">Next</a>
                </li>
            </ul>
        </nav>
        <p class="text-center text-muted small">Showing page @Model.PageNumber of @Model.TotalPages (@Model.TotalCount total payments)</p>
    }
</div>
