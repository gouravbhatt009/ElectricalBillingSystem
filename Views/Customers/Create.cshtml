@model CustomerViewModel
@{
    ViewData["Title"] = "Add Customer";
}

<div class="px-3">
    <h3 class="fw-bold mb-4">Add Customer</h3>
    <form asp-controller="Customers" asp-action="Create" method="post" class="card p-4 shadow-sm">
        <partial name="_CustomerForm" model="Model" />
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
